<!DOCTYPE html>
<html>

<head>

    <title>Edit Employee</title>

</head>

<body>

    <h1>Edit Employee</h1>


    <form
        action="/employee/edit/<%= employee._id %>"
        method="POST"
    >

        <label>Name:</label>

        <input
            type="text"
            name="name"
            value="<%= employee.name %>"
            required
        >

        <br><br>


        <label>Email:</label>

        <input
            type="email"
            name="email"
            value="<%= employee.email %>"
            required
        >

        <br><br>


        <label>Basic Salary:</label>

        <input
            type="number"
            name="basicSalary"
            value="<%= employee.basicSalary %>"
            required
        >

        <br><br>


        <button type="submit">
            Update
        </button>

    </form>


    <br>

    <a href="/dashboard">
        Back
    </a>

</body>

</html>