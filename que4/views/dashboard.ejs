<!DOCTYPE html>
<html>

<head>

    <title>ERP Dashboard</title>

</head>

<body>

    <h1>ERP Admin Dashboard</h1>

    <a href="/employee/add">
        Add Employee
    </a>

    <br><br>

    <a href="/logout">
        Logout
    </a>

    <hr>


    <h2>Employee List</h2>


    <table border="1" cellpadding="10">

        <tr>

            <th>Emp ID</th>

            <th>Name</th>

            <th>Email</th>

            <th>Basic Salary</th>

            <th>HRA</th>

            <th>DA</th>

            <th>Total Salary</th>

            <th>Action</th>

        </tr>


        <% employees.forEach(employee => { %>

        <tr>

            <td>
                <%= employee.empid %>
            </td>

            <td>
                <%= employee.name %>
            </td>

            <td>
                <%= employee.email %>
            </td>

            <td>
                <%= employee.basicSalary %>
            </td>

            <td>
                <%= employee.hra %>
            </td>

            <td>
                <%= employee.da %>
            </td>

            <td>
                <%= employee.totalSalary %>
            </td>

            <td>

                <a
                    href="/employee/edit/<%= employee._id %>"
                >
                    Edit
                </a>

                |

                <a
                    href="/employee/delete/<%= employee._id %>"
                >
                    Delete
                </a>

            </td>

        </tr>

        <% }) %>

    </table>

</body>

</html>